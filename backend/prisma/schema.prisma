generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ПОЛЬЗОВАТЕЛИ
// ============================================================
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  phone         String?
  address       String?
  isVerified    Boolean  @default(false)
  role          String   @default("user") // user, manager, admin
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // OAuth
  yandexId      String?  @unique
  maxId         String?  @unique

  // Связи
  orders        Order[]
  appointments  Appointment[]
  sessions      Session[]
  articles      Article[]
  comments      Comment[]
  likes         Like[]
}

// ============================================================
// СЕССИИ
// ============================================================
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ============================================================
// СТАТЬИ (ПОСТЫ)
// ============================================================
model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?   // Краткое описание для карточки
  content     String   // HTML контент статьи
  imageUrl    String?   // Главное изображение
  views       Int      @default(0)
  likesCount  Int      @default(0)
  readTime    Int?     // Время чтения в минутах
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Связи
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  tags        ArticleTagRelation[]
  images      ArticleImage[]
  comments    Comment[]
  likes       Like[]
}

// ============================================================
// ТЕГИ СТАТЕЙ
// ============================================================
model ArticleTag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  articles  ArticleTagRelation[]
}

model ArticleTagRelation {
  id         String   @id @default(cuid())
  articleId  String
  tagId      String
  article    Article  @relation(fields: [articleId], references: [id])
  tag        ArticleTag @relation(fields: [tagId], references: [id])

  @@unique([articleId, tagId])
}

// ============================================================
// ИЗОБРАЖЕНИЯ СТАТЕЙ (ГАЛЕРЕЯ)
// ============================================================
model ArticleImage {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  url       String
  filename  String
  size      Int?
  sortOrder Int      @default(0)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================================
// КОММЕНТАРИИ (С ВЛОЖЕННОСТЬЮ)
// ============================================================
model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Связи
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  
  // ✅ ВЛОЖЕННОСТЬ: parentId указывает на родительский комментарий
  parentId  String?
  parent    Comment? @relation("CommentHierarchy", fields: [parentId], references: [id])
  
  // ✅ ДОЧЕРНИЕ КОММЕНТАРИИ
  replies   Comment[] @relation("CommentHierarchy")

  likesCount Int     @default(0)
  isHidden  Boolean  @default(false)
}

// ============================================================
// ЛАЙКИ
// ============================================================
model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
}

// ============================================================
// ЗАКАЗЫ
// ============================================================
model Order {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  guestEmail     String?
  guestPhone     String?
  guestName      String?
  items          Json
  total          Float
  status         String   @default("pending") // pending | paid | confirmed | assembling | shipped | delivered | cancelled
  deliveryMethod String
  deliveryAddress String?
  comment        String?
  crmOrderId     String?
  orderNumber    String?
  paymentId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================
// ЗАПИСИ НА РЕМОНТ
// ============================================================
model Appointment {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id])
  carInfo      String?  // Марка, модель, год, госномер
  dateTime     DateTime
  status       String   @default("pending") // pending | confirmed | in_progress | completed | cancelled
  assignedTo   String?
  crmAppointmentId String?
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// НОВОСТИ (для главной)
// ============================================================
model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  imageUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// УСЛУГИ
// ============================================================
model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
}

// ============================================================
// КОРЗИНА
// ============================================================
model Cart {
  id        String   @id @default(cuid())
  userId    String?
  guestId   String?
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@unique([guestId])
}