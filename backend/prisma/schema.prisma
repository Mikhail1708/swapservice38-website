generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ПОЛЬЗОВАТЕЛИ
// ============================================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  middleName   String?
  phone        String?
  address      String?
  isVerified   Boolean  @default(false)
  role         String   @default("user") // user, manager, admin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // OAuth
  yandexId String? @unique
  maxId    String? @unique

  // Блокировка
  blockedAt     DateTime?
  blockedReason String?

  // Связи
  orders   Order[]
  sessions Session[]
  articles Article[]
  comments Comment[]
  likes    Like[]
  consents UserConsent[]
}

// Explicit evidence; legacy accounts are not backfilled.
model UserConsent {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  scopeVersion    String
  documentVersion String
  privacyVersion  String
  acceptedAt      DateTime @default(now())
  source          String
  orders          Order[]

  @@unique([userId, type, scopeVersion])
}

// ============================================================
// СЕССИИ
// ============================================================
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ============================================================
// СТАТЬИ (ПОСТЫ)
// ============================================================
model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String? // Краткое описание для карточки
  content     String // HTML контент статьи
  imageUrl    String? // Главное изображение
  views       Int      @default(0)
  likesCount  Int      @default(0)
  readTime    Int? // Время чтения в минутах
  isPublished Boolean  @default(false)
  type        String   @default("swap") // swap | service
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Связи
  authorId String
  author   User                 @relation(fields: [authorId], references: [id])
  tags     ArticleTagRelation[]
  images   ArticleImage[]
  comments Comment[]
  likes    Like[]
}

// ============================================================
// ТЕГИ СТАТЕЙ
// ============================================================
model ArticleTag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  articles ArticleTagRelation[]
}

model ArticleTagRelation {
  id        String     @id @default(cuid())
  articleId String
  tagId     String
  article   Article    @relation(fields: [articleId], references: [id])
  tag       ArticleTag @relation(fields: [tagId], references: [id])

  @@unique([articleId, tagId])
}

// ============================================================
// ИЗОБРАЖЕНИЯ СТАТЕЙ (ГАЛЕРЕЯ)
// ============================================================
model ArticleImage {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  url       String
  filename  String
  size      Int?
  sortOrder Int      @default(0)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================================
// КОММЕНТАРИИ (С ВЛОЖЕННОСТЬЮ)
// ============================================================
model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Связи
  authorId  String
  author    User    @relation(fields: [authorId], references: [id])
  articleId String
  article   Article @relation(fields: [articleId], references: [id])

  // ВЛОЖЕННОСТЬ
  parentId String?
  parent   Comment?  @relation("CommentHierarchy", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentHierarchy")

  likesCount Int     @default(0)
  isHidden   Boolean @default(false)
}

// ============================================================
// ЛАЙКИ
// ============================================================
model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
}

// ============================================================
// ЗАКАЗЫ
// ============================================================
model Order {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  offerVersion       String?
  offerAcceptedAt    DateTime?
  personalDataConsentId String?
  personalDataConsent UserConsent? @relation(fields: [personalDataConsentId], references: [id], onDelete: SetNull)
  guestName          String?
  guestMiddleName    String?
  guestEmail         String?
  guestPhone         String?
  customerFirstName  String?
  customerLastName   String?
  customerMiddleName String?
  customerPhone      String?
  customerEmail      String?
  contactMethod      String           @default("phone")
  items              Json
  total              Float
  status             String           @default("pending") // pending | paid | confirmed | assembling | shipped | delivered | cancelled
  deliveryMethod     String
  deliveryAddress    String?
  deliveryProvider   String?
  comment            String?
  crmOrderId         String?          @unique
  orderNumber        String?          @unique
  paymentId          String?          @unique
  crmStatusVersion   Int              @default(0)
  cancellationState String           @default("none")
  cancellationRequestedAt DateTime?
  cancellationResolvedAt  DateTime?
  cancellationReason      String?
  cancellationDecisionReason String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  paymentAttempts    PaymentAttempt[]

  @@index([cancellationState])
}

// Durable record created before any external payment-provider call. It keeps an
// order non-deletable while the outcome of that call is pending or unknown.
model PaymentAttempt {
  id                       String    @id @default(cuid())
  orderId                  String    @unique
  order                    Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider                 String
  idempotencyKey           String    @unique
  providerPaymentId        String?   @unique
  reservationId            String?   @unique
  reservationExpiresAt     DateTime?
  amountMinor              Int
  currency                 String    @default("RUB")
  status                   String    @default("initiating")
  providerRequestStartedAt DateTime?
  providerConfirmedAt      DateTime?
  lastCheckedAt            DateTime?
  lastError                String?
  refundReason             String?
  refundId                 String?
  refundRequestedAt        DateTime?
  refundedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([status, updatedAt])
}

// Transactional outbox for side effects that must follow a committed payment.
// aggregateId intentionally has no FK so a dispatched event remains auditable.
model OutboxEvent {
  id               String    @id @default(cuid())
  aggregateId      String
  type             String
  deduplicationKey String    @unique
  payload          Json
  status           String    @default("pending")
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now())
  lockedAt         DateTime?
  processedAt      DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([aggregateId, type])
}

// ============================================================
// УСЛУГИ
// ============================================================
model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// КОРЗИНА
// ============================================================
model Cart {
  id        String   @id @default(cuid())
  userId    String?
  guestId   String?
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@unique([guestId])
}

// ============================================================
// НАСТРОЙКИ САЙТА
// ============================================================
// Business email intent is committed with its business transaction, before Redis.
model EmailOutboxEvent {
  id               String    @id @default(cuid())
  eventType        String
  aggregateId      String
  deduplicationKey String    @unique
  payload          Json
  status           String    @default("pending")
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now())
  lockedAt         DateTime?
  processedAt      DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, lockedAt])
  @@index([aggregateId, eventType])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @default("")
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
