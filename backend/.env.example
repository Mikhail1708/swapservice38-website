# ============================================================
# СЕРВЕР
# ============================================================
PORT=5001
NODE_ENV=development
TRUST_PROXY_HOPS=0

# Password reset abuse protection
PASSWORD_RESET_CODE_TTL_SECONDS=900
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_ATTEMPT_WINDOW_SECONDS=900
PASSWORD_RESET_IP_WINDOW_SECONDS=900
PASSWORD_RESET_IP_REQUEST_MAX=5
PASSWORD_RESET_IP_ATTEMPT_MAX=30

# ============================================================
# БАЗА ДАННЫХ
# ============================================================
DATABASE_URL=postgresql://postgres:password@localhost:5433/site_db
DB_PASSWORD=your_db_password

# ============================================================
# REDIS
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# JWT
# ============================================================
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ============================================================
# EMAIL (Яндекс)
# ============================================================
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@yandex.ru
SMTP_PASS=your_app_password_here
EMAIL_FROM=your_email@yandex.ru
MANAGER_EMAIL=your_email@yandex.ru

# ============================================================
# CRM (СУЩЕСТВУЮЩАЯ СИСТЕМА)
# ============================================================
CRM_API_URL=http://localhost:5000
CRM_OUTBOX_POLL_MS=5000
# Automatic refund retries are bounded; exhausted refunds become refund_failed
# and require the idempotent admin replay action.
REFUND_MAX_ATTEMPTS=8
INTERNAL_API_KEY=your_internal_api_key_here
WEBHOOK_SECRET=your_webhook_secret_here

# ============================================================
# КЛИЕНТ (ФРОНТЕНД)
# ============================================================
CLIENT_URL=http://localhost:3000

# ============================================================
# OAuth: ЯНДЕКС
# ============================================================
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
YANDEX_REDIRECT_URI=http://localhost:5001/api/auth/yandex/callback

# ============================================================
# OAuth: MAX
# ============================================================
MAX_CLIENT_ID=your_max_client_id
MAX_CLIENT_SECRET=your_max_client_secret
MAX_REDIRECT_URI=http://localhost:5001/api/auth/max/callback

# ============================================================
# ПЛАТЁЖНАЯ СИСТЕМА (ЮKassa)
# ============================================================
PAYMENT_PROVIDER=mock
# Positive integer 1..120000 ms; missing/invalid values use 15000. No automatic POST retry.
PAYMENT_HTTP_TIMEOUT_MS=15000
YOO_KASSA_SHOP_ID=your_shop_id
YOO_KASSA_SECRET_KEY=your_secret_key

# ============================================================
# API (ДЛЯ ФРОНТЕНДА)
# ============================================================
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://localhost:5001
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001

# ============================================================
# ЯНДЕКС ГЕОКОДЕР
# ============================================================

# ============================================================
# DaData (АВТОПОДСКАЗКИ АДРЕСОВ)
# ============================================================
DADATA_API_KEY=your_dadata_server_key
